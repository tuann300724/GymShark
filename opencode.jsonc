{
  "$schema": "https://opencode.ai/config.json",
  // Tự format file sau mỗi lần agent edit/write (Prettier đã cấu hình sẵn)
  "formatter": true,
  // Bỏ các thư mục generate khỏi vòng quay file watch → session nhẹ, agent đọc file nhanh hơn
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/.git/**",
      "coverage/**",
      "*.log"
    ]
  },
  // Quy tắc xác nhận: git push PHẢI hỏi trước, không bao giờ tự đẩy
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" }
  ],
  // GitHub MCP (remote, đăng nhập OAuth qua lệnh /mcps sau khi nạp config)
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      }
    }
  }
}
