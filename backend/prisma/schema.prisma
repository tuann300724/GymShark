datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  TRAINER
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
}

enum TrainerStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum PackageType {
  FIXED_TERM
  SESSION_BASED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  MOMO
  VNPAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CheckInStatus {
  CHECKED_IN
  CHECKED_OUT
}

enum ScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum EquipmentStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  BROKEN
  RETIRED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model Branch {
  id           String      @id @default(uuid())
  code         String      @unique
  name         String
  address      String
  phone        String
  email        String?
  openingHours String?
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users        User[]
  members      Member[]
  rooms        Room[]
  equipment    Equipment[]
  checkIns     CheckIn[]

  @@index([code])
  @@index([status])
}

model Room {
  id        String      @id @default(uuid())
  name      String
  capacity  Int         @default(20)
  status    String      @default("AVAILABLE")
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  equipment Equipment[]
  schedules TrainingSchedule[]

  @@index([branchId])
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole      @default(STAFF)
  status       UserStatus    @default(ACTIVE)
  avatarUrl    String?
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trainer       Trainer?
  member        Member?
  notifications Notification[]

  @@index([email])
  @@index([role])
  @@index([branchId])
}

model Trainer {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String
  certification   String?
  experienceYears Int                @default(1)
  bio             String?
  rating          Float              @default(5.0)
  hourlyRate      Decimal?           @db.Decimal(10, 2)
  status          TrainerStatus      @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  schedules       TrainingSchedule[]

  @@index([userId])
  @@index([status])
}

model Member {
  id               String             @id @default(uuid())
  code             String             @unique
  userId           String?            @unique
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName         String
  email            String?
  phone            String
  gender           Gender             @default(MALE)
  dateOfBirth      DateTime?
  address          String?
  avatarUrl        String?
  status           MemberStatus       @default(ACTIVE)
  notes            String?
  emergencyContact String?
  joinedAt         DateTime           @default(now())
  branchId         String
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  memberships      Membership[]
  payments         Payment[]
  checkIns         CheckIn[]
  schedules        TrainingSchedule[]
  notifications    Notification[]

  @@index([code])
  @@index([phone])
  @@index([branchId])
  @@index([status])
}

model MembershipPackage {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  description  String?
  features     Json?
  durationDays Int
  price        Decimal       @db.Decimal(12, 2)
  sessions     Int?
  type         PackageType   @default(FIXED_TERM)
  status       String        @default("ACTIVE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships  Membership[]

  @@index([code])
  @@index([status])
}

model Membership {
  id                String           @id @default(uuid())
  memberId          String
  member            Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  packageId         String
  package           MembershipPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  startDate         DateTime
  endDate           DateTime
  price             Decimal          @db.Decimal(12, 2)
  remainingSessions Int?
  status            MembershipStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  payments          Payment[]

  @@index([memberId])
  @@index([packageId])
  @@index([status])
  @@index([endDate])
}

model Payment {
  id             String        @id @default(uuid())
  code           String        @unique
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membershipId   String?
  membership     Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  promotionId    String?
  promotion      Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(COMPLETED)
  transactionRef String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([code])
  @@index([memberId])
  @@index([status])
  @@index([createdAt])
}

model CheckIn {
  id           String        @id @default(uuid())
  memberId     String
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  checkInTime  DateTime      @default(now())
  checkOutTime DateTime?
  status       CheckInStatus @default(CHECKED_IN)
  notes        String?
  createdAt    DateTime      @default(now())

  @@index([memberId])
  @@index([branchId])
  @@index([checkInTime])
}

model TrainingSchedule {
  id        String         @id @default(uuid())
  title     String
  trainerId String
  trainer   Trainer        @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  memberId  String?
  member    Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  roomId    String?
  room      Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  startTime DateTime
  endTime   DateTime
  status    ScheduleStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([trainerId])
  @@index([memberId])
  @@index([startTime])
  @@index([status])
}

model Promotion {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?
  discountType DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(12, 2)
  minOrderValue Decimal?     @db.Decimal(12, 2)
  maxDiscount  Decimal?     @db.Decimal(12, 2)
  startDate    DateTime
  endDate      DateTime
  usageLimit   Int?
  usedCount    Int          @default(0)
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  payments     Payment[]

  @@index([code])
  @@index([status])
}

model Equipment {
  id             String                 @id @default(uuid())
  code           String                 @unique
  name           String
  category       String
  branchId       String
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomId         String?
  room           Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  purchaseDate   DateTime?
  purchasePrice  Decimal?               @db.Decimal(12, 2)
  status         EquipmentStatus        @default(OPERATIONAL)
  warrantyExpiry DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  maintenances   EquipmentMaintenance[]

  @@index([code])
  @@index([branchId])
  @@index([status])
}

model EquipmentMaintenance {
  id              String            @id @default(uuid())
  equipmentId     String
  equipment       Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceDate DateTime          @default(now())
  cost            Decimal?          @db.Decimal(10, 2)
  description     String
  performedBy     String?
  status          MaintenanceStatus @default(COMPLETED)
  nextDueDate     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([equipmentId])
  @@index([maintenanceDate])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([memberId])
  @@index([isRead])
}
