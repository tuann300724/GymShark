# ===== Gym Management Backend — Environment Example =====
# Copy sang file `.env` (KHÔNG commit .env thật) và chỉnh giá trị phù hợp.

# Server
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL)
# Production: KHÔNG dùng migrate dev — dùng `npx prisma migrate deploy`
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/gym_db?schema=public"

# JWT — bắt buộc đổi thành chuỗi ngẫu nhiên dài khi deploy (VD: openssl rand -hex 32)
JWT_SECRET="CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# CORS — danh sách origin FE được phép (phân tách dấu phẩy nếu nhiều origin)
CORS_ORIGIN="http://localhost:3000"

# Frontend URL (dùng cho link/redirect nếu cần)
FRONTEND_URL="http://localhost:3000"

# Rate limiting (mặc định đã cấu hình trong code — có thể điều chỉnh qua env nếu deploy)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=300

# Sinh trắc học — ngưỡng cosine similarity coi là "khớp" (0..1)
# + Dễ nhận nhầm (false accept) → TĂNG ngưỡng; hay từ chối nhầm (false reject) → GIẢM ngưỡng
# 1:1 — hội viên tự quét (nới lỏng hơn vì đã biết người đó là ai)
FACE_MATCH_THRESHOLD=0.6
# 1:N — lễ tân quét (CHẶT hơn vì chọn nhầm = ghi sai lượt tập)
FACE_MATCH_THRESHOLD_1N=0.7

# ===== Kiểm tra đeo kính (Azure AI Vision Face) =====
# BẮT BUỘC đọc trước khi bật: bước này CHUYỂN ẢNH khuôn mặt của hội viên lên máy chủ
# Microsoft để phân loại. Đây là dữ liệu sinh trắc học RỜI KHỎI MÁY, nên văn bản đồng
# ý (NĐ13/2023) ở giao diện bắt buộc phải nói rõ điều này.
#
# Lấy key: Azure Portal → tạo resource "Azure AI Vision" (giá F0 miễn phí 1.000 lượt/tháng)
#   → Keys and Endpoint → copy Key1 + Endpoint.
# Lưu ý: chỉ thao tác **Detect** (đọc thuộc tính ảnh). Detect KHÔNG thuộc nhóm
#   "Limited Access" nên KHÔNG cần đăng ký duyệt — chỉ Identify/Verify mới cần.
# Nếu thiếu key, hệ thống in cảnh báo lúc khởi động và BỎ QUA bước kiểm tra kính
# (đăng ký khuôn mặt vẫn chạy bình thường, chỉ không chặn người đeo kính).
FACE_GLASSES_CHECK=true
AZURE_FACE_ENDPOINT="https://<ten-resource>.cognitiveservices.azure.com"
AZURE_FACE_KEY="CHANGE_ME"

# ===== Gửi email (SMTP) — dùng cho mã xác minh đăng ký hội viên =====
# Gmail: bật 2FA rồi tạo "Mật khẩu ứng dụng" tại
#   https://myaccount.google.com/apppasswords  (KHÔNG dùng mật khẩu tài khoản Gmail thường)
# Trong SMTP_PASS dán đúng 16 ký tự, Gmail sẽ tự chèn khoảng trắng — bỏ khoảng trắng đi.
# KHÔNG commit file .env thật.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
# true = kết nối TLS ngay (cổng 465). Để trống/false = STARTTLS trên cổng 587.
SMTP_SECURE=false
# Bắt buộc nâng cấp STARTTLS khi gửi (mặc định true — bắt buộc với Gmail).
# Chỉ đặt false khi chạy test với SMTP server cục bộ không hỗ trợ TLS.
SMTP_REQUIRE_TLS=true
SMTP_USER="your.gmail@gmail.com"
SMTP_PASS="abcd efgh ijkl mnop"
# Tên hiển thị trong hộp thư người nhận
MAIL_FROM_NAME="GymMaster Pro"

# Thời hạn mã xác minh (phút) và khoảng nghỉ gửi lại mã (giây) đang cố định trong
# backend/src/modules/auth/auth.service.ts (VERIFY_CODE_TTL_MINUTES / RESEND_COOLDOWN_SECONDS).

# ===== Đăng nhập bằng Google (OAuth 2.0) =====
# Lấy ở Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# GOOGLE_CALLBACK_URL phải khớp y hệt URI đã đăng ký trong mục Authorized redirect URIs.
GOOGLE_CLIENT_ID="CHANGE_ME"
GOOGLE_CLIENT_SECRET="CHANGE_ME"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"