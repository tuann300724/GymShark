{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "plugin:tailwindcss/recommended",
    "plugin:jsx-a11y/recommended",
    "prettier"
  ],
  "settings": {
    "tailwindcss": {
      "config": "tailwind.config.ts"
    }
  },
  "rules": {
    "tailwindcss/classnames-order": "off",
    "jsx-a11y/no-autofocus": "warn"
  }
}
